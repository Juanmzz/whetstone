{
  "env": {
    "ENGRAM_PROJECT": "whetstone"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/strict-path-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
