# OS / editor
.DS_Store

# Node
node_modules
dist/

# Scaffolding: design drafts, research, sprint notes. Working material, not the product.
# The decisions they produced live in .sdd/memory/decisions/ — that is what travels.
_design/

# Whetstone: memory index is a regenerable cache (M2 SQLite adapter).
# Files under .sdd/memory/ remain the source of truth and ARE committed.
.sdd/memory/index.db

# Compiled check index: regenerable from .sdd/checks/*.md via `wst check --compile`.
# Deliberately NOT committed — a compiled artifact that can silently go stale is the
# same trap as trusting a version string for identity.
.sdd/checks/_index.json

# Per-worktree lane marker, read by .claude/hooks/lane-guard.mjs. Belongs to the
# worktree, not to the branch — committing it would scope every clone to one lane.
.wst-lane

# The briefing `wst run --prepare` writes into a leased worktree. Same argument as
# .wst-lane: it belongs to the worktree, not the branch. Observed — a crewmate ran
# `git add -A` and swept its own charter into the diff it was dispatched to produce.
.wst-charter.md

# Receipts are a derived cache: "check X passed on this exact input". Regenerable,
# and a stale one would claim a pass that never happened for the current code.
.sdd/receipts/
