{
  "name": "whetstone",
  "version": "0.4.0-alpha",
  "description": "A self-sharpening standards layer for AI coding agents \u2014 git-native, files-first.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wst": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    ".wst/skills"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:adrs": "tsx scripts/check-adrs.ts",
    "untested": "tsx scripts/untested.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "mutate": "tsx scripts/mutate.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
