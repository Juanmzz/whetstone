{
  "name": "@juanmzz/whetstone",
  "version": "0.5.0",
  "description": "A self-sharpening standards layer for AI coding agents — git-native, files-first.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juanmzz/whetstone.git"
  },
  "homepage": "https://github.com/Juanmzz/whetstone#readme",
  "bugs": {
    "url": "https://github.com/Juanmzz/whetstone/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "code-review",
    "gate",
    "tdd",
    "claude",
    "llm",
    "ci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "wst": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    ".wst/skills",
    "plugin",
    ".claude-plugin"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:adr-refs": "tsx scripts/check-adr-refs.ts",
    "check:docs": "tsx scripts/check-docs-fresh.ts",
    "check:in-force": "tsx scripts/check-in-force.ts",
    "check:comments": "tsx scripts/check-comment-density.ts",
    "fix:docs": "tsx scripts/check-docs-fresh.ts --fix",
    "check:provenance": "tsx scripts/check-provenance.ts",
    "check:skills": "tsx scripts/check-skills.ts",
    "untested": "tsx scripts/untested.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "mutate": "tsx scripts/mutate.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
